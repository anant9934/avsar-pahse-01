# ==============================================================================
# AVSAR PRODUCTION ENVIRONMENT CONFIGURATION SPECIFICATION (.env.example)
# ==============================================================================
# Copy this file to .env.local for development, or configure these variables in
# your production deployment environment (Vercel, AWS ECS, GCP Cloud Run, Docker).
# Note: Privileged credentials are server-only. Never expose them with NEXT_PUBLIC_.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database & Connection Pooling (Production Mandatory)
# ------------------------------------------------------------------------------
# Standard connection string for managed PostgreSQL (Neon, Supabase, RDS, GCP Cloud SQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
# In production (NODE_ENV=production), application refuses to start if missing.
DATABASE_URL=postgresql://avsar_user:your_secure_db_password_here@ep-example-pooler.ap-southeast-1.aws.neon.tech/avsar?sslmode=require

# Maximum connection pool size (Default: 20)
DB_POOL_MAX=20

# Connection idle timeout in milliseconds (Default: 30000)
DB_POOL_IDLE_TIMEOUT_MS=30000

# Connection acquisition timeout in milliseconds (Default: 5000)
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# 2. Private Durable Object Storage (AWS S3, Cloudflare R2, MinIO, Supabase)
# ------------------------------------------------------------------------------
# Storage provider: 's3' for production cloud storage, or 'local' for local disk dev
STORAGE_PROVIDER=s3

# Private bucket name (MANDATORY if STORAGE_PROVIDER=s3)
# Buckets must have public access completely blocked. All access is signed or proxied.
STORAGE_BUCKET=avsar-production-resumes-private

# AWS Region or cloud storage datacenter region (Default: us-east-1)
STORAGE_REGION=us-east-1

# Custom endpoint URL for S3-compatible providers (Cloudflare R2, MinIO, Supabase S3)
# Leave blank for standard AWS S3.
# Example for Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
# Example for local MinIO: http://localhost:9000
STORAGE_ENDPOINT=

# Server-side access key ID for object storage (Server-only, do not prefix with NEXT_PUBLIC_)
STORAGE_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE

# Server-side secret access key for object storage (Server-only)
STORAGE_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Force path style URLs (Set to 'true' for MinIO or LocalStack, 'false' for AWS/R2)
STORAGE_FORCE_PATH_STYLE=false

# ------------------------------------------------------------------------------
# 3. AI Tathastu OAuth 2.0 & OIDC Identity Provider (Authoritative IdP)
# ------------------------------------------------------------------------------
# Registered client ID for Avsar on AI Tathastu (Required)
AI_TATHASTU_CLIENT_ID=avsar_prod_client_id

# Confidential client secret issued during registration (Required for server-to-server code exchange)
AI_TATHASTU_CLIENT_SECRET=sec_live_aitathastu_secret_key_here

# Base URL / Issuer for AI Tathastu Identity Provider
# Defaults to https://www.aitathastu.com
AI_TATHASTU_ISSUER_URL=https://www.aitathastu.com

# Authoritative redirect URI registered with AI Tathastu IdP
# Must exactly match the configured URL on the provider
AVSAR_AUTH_REDIRECT_URI=http://localhost:3000/api/auth/aitathastu/callback

# ------------------------------------------------------------------------------
# 4. Avsar Session & Cryptographic Token Security
# ------------------------------------------------------------------------------
# 32+ byte high-entropy secret key used to HMAC-SHA256 sign and verify session cookies
# MANDATORY in production environments. Application will fail safe if missing.
# Generate with: openssl rand -base64 32
AVSAR_SESSION_SECRET=generate_a_random_32_character_high_entropy_secret_string

# ------------------------------------------------------------------------------
# 5. Administrative Privileged Access & Security
# ------------------------------------------------------------------------------
# Secret key required for admin login, metrics inspection, and bulk job imports.
# In production (NODE_ENV=production), this variable is STRICTLY REQUIRED.
# If unset in production, admin operations will fail-safe with 503 Service Unavailable.
AVSAR_ADMIN_SECRET=generate_strong_production_admin_passkey_here

# ------------------------------------------------------------------------------
# 6. Host Origin & Networking
# ------------------------------------------------------------------------------
# Production origin of the Avsar deployment for same-origin policy validation
AVSAR_APP_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 7. Developer & Demo Flags
# ------------------------------------------------------------------------------
# Allow one-click demo login (Rohan Sharma) in non-production environments.
# In production (NODE_ENV=production), demo login is blocked by default unless
# explicitly enabled by setting ALLOW_DEMO_AUTH=true.
ALLOW_DEMO_AUTH=false
